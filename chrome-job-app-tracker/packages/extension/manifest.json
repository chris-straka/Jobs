{
  "manifest_version": 3,
  "name": "Job Application Tracker",
  "version": "0.1.0",
  "description": "Capture the posting in the current tab into the Jobs repo via the local capture server.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save job posting",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "activeTab", "clipboardWrite", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "dist/background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://hiring.cafe/*",
        "https://hiringcafe.com/*",
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.workable.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.brightnetwork.co.uk/*",
        "https://www.linkedin.com/*",
        "https://*.indeed.com/*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
