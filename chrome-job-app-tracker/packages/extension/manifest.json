{
  "manifest_version": 3,
  "name": "ja",
  "version": "0.1.0",
  "description": "Capture the posting in the current tab into the Jobs repo. Also declutters LinkedIn (modules, ads, news, feed).",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save job posting",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "activeTab", "clipboardWrite", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "dist/background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://linkedin.com/*", "*://*.linkedin.com/*"],
      "js": ["dist/linkedin-early.js"],
      "run_at": "document_start"
    }
  ]
}
